// =============================================================================
// Kubernal IDP – Prisma Schema
// PostgreSQL 16 – Modèle de domaine
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Utilisateur ────────────────────────────────────────────────────────────
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  role         String    @default("developer") // viewer | developer | platform_engineer | admin | security_admin
  teamId       String?
  // SET NULL explicite : aligne le schéma sur la DB (migrations initiales) et évite
  // qu'un futur `migrate dev` régresse vers RESTRICT (suppression d'équipe = 500).
  team         Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  passwordHash String?
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  oidcProvider String?
  oidcId       String?

  ownedApplications   Application[]    @relation("Owner")
  approvedDeployments  Deployment[]     @relation("Approver")
  sessions             Session[]
  apiKeys              ApiKey[]
  notificationPreferences UserNotificationPreference[]

  @@unique([oidcProvider, oidcId])
}

model Session {
  sid        String   @id @default(uuid())
  data       Json     @default("{}")
  expiresAt  DateTime?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ─── Équipe ─────────────────────────────────────────────────────────────────
model Team {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  quotaCpu        String   @default("4")
  quotaMemory     String   @default("8Gi")
  namespacePrefix String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members      User[]
  applications Application[]
}

// ─── Template (Golden Path) ─────────────────────────────────────────────────
model GoldenPathTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  version     String   @default("1.0.0")
  category    String   // backend | frontend | fullstack | library | function
  description String
  repository  String
  parameters  Json     @default("{}")
  steps       Json     @default("[]")
  createdAt   DateTime @default(now())

  applications Application[]
}

// ─── Application ────────────────────────────────────────────────────────────
model Application {
  id            String   @id @default(uuid())
  name          String
  description   String?
  templateId    String
  template      GoldenPathTemplate @relation(fields: [templateId], references: [id])
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)
  ownerId       String
  // CASCADE : le portail promet « Supprime définitivement votre compte et toutes les
  // données associées ». La FK est scopée à ownerId, donc ne supprime QUE les apps dont
  // ownerId = cet utilisateur — jamais celles d'un autre owner. L'historique
  // d'approbation des autres users est préservé (Deployment.approvedBy = SetNull).
  owner         User     @relation("Owner", fields: [ownerId], references: [id], onDelete: Cascade)
  repositoryUrl  String?
  webhookSecret  String?
  status         String   @default("creating") // creating | active | failed | archived
  config         Json     @default("{}")
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  environments  Environment[]
  deployments   Deployment[]
  webhookConfigs WebhookConfig[]
}

// ─── Environnement ──────────────────────────────────────────────────────────
model Environment {
  id               String @id @default(uuid())
  name             String
  type             String // dev | staging | prod
  applicationId    String
  // CASCADE : supprimer une application emporte ses environnements.
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  namespace        String
  clusterName      String @default("kubernal")
  requiresApproval Boolean @default(false)
  createdAt        DateTime @default(now())

  deployments Deployment[]
}

// ─── Déploiement ────────────────────────────────────────────────────────────
model Deployment {
  id               String    @id @default(uuid())
  applicationId    String
  // CASCADE : la suppression d'une application est déjà un choix destructif assumé
  // (l'app est la racine de son arbre : envs → déploiements → pipelines → étapes).
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  environmentId    String
  // CASCADE : un environnement ne vit pas sans son application. Empêcher la suppression
  // d'un env peuplé n'est pas tenable ici — l'API n'expose aucun DELETE /deployments/:id,
  // donc un RESTRICT rendrait ces environnements définitivement indétruits. La voie
  // non destructive reste POST /applications/:id/archive.
  environment      Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  version          String
  commitSha        String
  status           String    @default("pending") // pending | building | deploying | healthy | failed | rolled_back | cancelled
  trigger          String    @default("manual") // manual | git_push | scheduled | rollback
  approvedById     String?
  // SET NULL (jamais CASCADE) : le déploiement, et donc la trace de son approbation,
  // doit survivre à la suppression de l'utilisateur qui l'avait approuvé. Le champ est
  // nullable, ce qui rend cette politique possible.
  approvedBy       User?     @relation("Approver", fields: [approvedById], references: [id], onDelete: SetNull)
  artifacts        Json      @default("[]")
  policyViolations Json      @default("[]")
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  pipelines Pipeline[]
  vulnerabilities DeploymentVulnerability[]
}

// ─── Pipeline ───────────────────────────────────────────────────────────────
model Pipeline {
  id           String    @id @default(uuid())
  deploymentId String
  // CASCADE : un pipeline n'a aucun sens sans son déploiement (idem
  // DeploymentVulnerability). Évite le 500 sur suppression d'un déploiement peuplé.
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  name         String
  status       String    @default("running") // running | success | failed | cancelled
  stages       Json      @default("[]")
  logsUrl      String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  steps PipelineStep[]
}

// ─── Pipeline Step ──────────────────────────────────────────────────────────
model PipelineStep {
  id           String   @id @default(uuid())
  pipelineId   String
  pipeline     Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name         String
  order        Int
  status       String   @default("pending") // pending | running | success | failed | skipped
  action       String
  params       Json     @default("{}")
  output       Json?
  errorMessage String?  @db.Text
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([pipelineId])
  @@index([status])
}

// ─── Deployment Vulnerability (Trivy / Snyk / Grype) ────────────────────────
model DeploymentVulnerability {
  id             String   @id @default(uuid())
  deploymentId   String
  deployment     Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  cveId          String
  severity       String   // critical | high | medium | low
  packageName    String
  packageVersion String
  fixedVersion   String?
  title          String
  description    String?  @db.Text
  scanSource     String   @default("trivy")
  rawReport      Json     @default("{}")
  detectedAt     DateTime @default(now())

  @@index([deploymentId])
  @@index([severity])
  @@index([cveId])
}

// ─── Politique de Sécurité ─────────────────────────────────────────────────
model SecurityPolicy {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  category    String   // security | compliance | cost | operations
  severity    String   // critical | high | medium | low
  engine      String   // kyverno | opa | custom
  rules       Json     @default("{}")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ─── Observabilité ─────────────────────────────────────────────────────────
model ObservabilityConfig {
  id              String  @id @default(uuid())
  applicationId   String  @unique
  teamId          String
  dashboardUrl    String?
  alertsEnabled   Boolean @default(true)
  logRetentionDays Int    @default(30)
  tracingSampleRate Float @default(0.1)
  createdAt       DateTime @default(now())
}

// ─── Webhook Outbound ────────────────────────────────────────────────────────
model WebhookConfig {
  id            String   @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String   @default("default")
  url           String
  secret        String?
  events        String[] @default(["started", "success", "failure"])
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([applicationId])
}

model WebhookDelivery {
  id              String   @id @default(uuid())
  webhookConfigId String
  webhookConfig   WebhookConfig @relation(fields: [webhookConfigId], references: [id], onDelete: Cascade)
  event           String
  status          String   @default("pending") // pending | success | failed
  requestBody     Json?
  responseStatus  Int?
  responseBody    String?  @db.Text
  durationMs      Int?
  errorMessage    String?  @db.Text
  retryCount      Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([webhookConfigId])
  @@index([status])
}

// ─── API Key ──────────────────────────────────────────────────────────────────
model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  prefix     String    @default("kpl_")
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ─── Audit Log ────────────────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  action     String   // CREATE | UPDATE | DELETE | LOGIN | TRANSITION | etc
  resource   String   // "Application" | "Deployment" | "WebhookConfig" | etc
  resourceId String?
  details    Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ─── User Notification Preferences ─────────────────────────────────────────
model UserNotificationPreference {
  id        String   @id @default(uuid())
  userId    String
  type      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}
