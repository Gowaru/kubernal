# =============================================================================
# kubernal API — environment variables (TEMPLATE)
# =============================================================================
# ⚠️  NEVER COMMIT A REAL .env — copy this file to .env and fill locally.
#     .env IS in .gitignore and stays out of git history.
#
# Where to get values: see docs/SECURITY.md
# =============================================================================

# ─── Base de données ─────────────────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<db>?schema=public
# Dev (local):    localhost:5432
# In-cluster:     postgres-service:5432
DATABASE_URL="postgresql://kubernal:<PLACEHOLDER_DB_PASSWORD>@localhost:5432/kubernal_idp?schema=public"

# ─── Serveur ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ─── Git & Container Registry (Phase 13) ────────────────────────────────────
# Default repository used by the catalogue and webhook tests
GITHUB_REPO_SLUG=your-org/your-repo

# GitHub Personal Access Token (scopes: repo, read:org, write:packages)
#   - Used by demo-ghcr-trivy.ts and the webhook controller for private repos
#   - Used by `docker login ghcr.io` (also stored in ~/.docker/config.json)
#   - Get one at https://github.com/settings/tokens
GITHUB_TOKEN=<PLACEHOLDER_GITHUB_TOKEN>

# Alias for clarity in build helpers (same value as GITHUB_TOKEN today,
# kept separate so we can swap to GHCR-specific tokens later)
GHCR_TOKEN=<PLACEHOLDER_GHCR_TOKEN>

# GitHub OAuth App credentials (Backstage login)
#   - Register at https://github.com/settings/developers
#   - Authorization callback URL: https://backstage.kubernal.local/api/auth/github/handler/frame
GITHUB_CLIENT_ID=<PLACEHOLDER_GITHUB_CLIENT_ID>
GITHUB_CLIENT_SECRET=<PLACEHOLDER_GITHUB_CLIENT_SECRET>

# ─── Kubernetes ──────────────────────────────────────────────────────────────
# Path to kubeconfig (dev only — in-cluster mode uses pod ServiceAccount)
KUBECONFIG=<PLACEHOLDER_KUBECONFIG_PATH>

# ─── Security / session ─────────────────────────────────────────────────────
# 32+ char random string for signing session tokens / CSRF
SESSION_SECRET=<PLACEHOLDER_SESSION_SECRET>

# Shared secret required in the `x-internal-api-key` header for protected
# internal endpoints (e.g. POST /applications/:appId/webhook/regenerate).
# Generate with: `openssl rand -hex 32`
# Leave UNSET in dev: the middleware will refuse the request and log an error.
# In prod, set this to a 32+ char random value injected from your secret store.
INTERNAL_API_KEY=<PLACEHOLDER_INTERNAL_API_KEY>

# ─── Portal (SSO redirect) ──────────────────────────────────────────────────
PORTAL_URL=http://localhost:3000

# ─── Logger ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
