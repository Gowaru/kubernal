  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Validation error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "NotFoundError": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": { "type": "object" }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["success", "error"]
      },
      "PaginatedResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "type": "object" }
          },
          "total": { "type": "integer" }
        },
        "required": ["data", "total"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "name": { "type": "string" },
          "role": { "type": "string", "enum": ["developer", "platform_engineer", "security_admin"] },
          "teamId": { "type": "string", "format": "uuid", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "email", "name", "role", "createdAt", "updatedAt"]
      },
      "Team": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "quotaCpu": { "type": "string" },
          "quotaMemory": { "type": "string" },
          "namespacePrefix": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "quotaCpu", "quotaMemory", "namespacePrefix", "createdAt", "updatedAt"]
      },
      "GoldenPathTemplate": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "version": { "type": "string" },
          "category": { "type": "string", "enum": ["backend", "frontend", "fullstack", "library", "function"] },
          "description": { "type": "string" },
          "repository": { "type": "string", "format": "uri" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "version", "category", "description", "repository", "createdAt"]
      },
      "Application": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "templateId": { "type": "string", "format": "uuid" },
          "teamId": { "type": "string", "format": "uuid" },
          "ownerId": { "type": "string", "format": "uuid" },
          "repositoryUrl": { "type": "string", "format": "uri", "nullable": true },
          "status": { "type": "string", "enum": ["creating", "active", "failed", "archived"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "templateId", "teamId", "ownerId", "status", "createdAt", "updatedAt"]
      },
      "Environment": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["dev", "staging", "prod"] },
          "applicationId": { "type": "string", "format": "uuid" },
          "namespace": { "type": "string" },
          "clusterName": { "type": "string" },
          "requiresApproval": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "type", "applicationId", "namespace", "clusterName", "requiresApproval", "createdAt"]
      },
      "Deployment": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "applicationId": { "type": "string", "format": "uuid" },
          "environmentId": { "type": "string", "format": "uuid" },
          "version": { "type": "string" },
          "commitSha": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "building", "deploying", "healthy", "failed", "rolled_back", "cancelled"] },
          "trigger": { "type": "string", "enum": ["manual", "git_push", "scheduled", "rollback"] },
          "approvedById": { "type": "string", "format": "uuid", "nullable": true },
          "policyViolations": { "type": "array", "items": { "type": "object" } },
          "startedAt": { "type": "string", "format": "date-time" },
          "completedAt": { "type": "string", "format": "date-time", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "applicationId", "environmentId", "version", "commitSha", "status", "trigger", "startedAt", "createdAt"]
      },
      "Pipeline": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "deploymentId": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["running", "success", "failed", "cancelled"] },
          "stages": { "type": "array", "items": { "type": "object" } },
          "logsUrl": { "type": "string", "nullable": true },
          "startedAt": { "type": "string", "format": "date-time" },
          "completedAt": { "type": "string", "format": "date-time", "nullable": true }
        },
        "required": ["id", "deploymentId", "name", "status", "startedAt"]
      },
      "SecurityPolicy": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string", "enum": ["security", "compliance", "cost", "operations"] },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "engine": { "type": "string", "enum": ["kyverno", "opa", "custom"] },
          "rules": { "type": "object" },
          "enabled": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "description", "category", "severity", "engine", "enabled", "createdAt"]
      }
    }
  },
