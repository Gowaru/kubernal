# Docker
docker-data/

# Kubernetes local
.kubeconfig
kustomize

# TLS certificates (regenerated on demand)
infra/k8s/tls/*.key
infra/k8s/tls/*.crt

# Kubernetes secrets (real values live in *.yaml.example templates)
# Overlay plaintext secrets (NEVER commit — used as input to kubeseal)
infra/k8s/overlays/*/secret*.yaml
# Legacy patterns for any secret*.yaml under infra/k8s
infra/k8s/**/secret.yaml
*.secret.yaml
**/secrets/
# Allow sealed secret templates
!**/sealed-secret*.yaml

# Generic credentials & key material
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.asc
.gpg/

# Docker registry credentials
.docker/config.json
config.json
config.json.bak

