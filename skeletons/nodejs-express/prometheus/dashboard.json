{
  "title": "{{name}}",
  "panels": [
    {
      "title": "HTTP Requests",
      "type": "graph",
      "targets": [{ "expr": "rate(http_requests_total{service=\"{{name}}\"}[5m])" }]
    },
    {
      "title": "CPU Usage",
      "type": "graph",
      "targets": [{ "expr": "rate(process_cpu_seconds_total{service=\"{{name}}\"}[5m])" }]
    }
  ]
}
