# =============================================================================
# infra/ — shared environment variables for local k8s dev cluster (TEMPLATE)
# =============================================================================
# ⚠️  NEVER COMMIT A REAL .env — copy this file to .env and fill locally.
#     Used by docker-compose, kustomize, and the local kind cluster.
#
# Where to get values: see docs/SECURITY.md
# =============================================================================

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=kubernal
POSTGRES_PASSWORD=<PLACEHOLDER_POSTGRES_PASSWORD>
POSTGRES_DB=kubernal_idp

# ─── pgAdmin (local dev UI) ──────────────────────────────────────────────────
# http://localhost:5050  (login: admin@local / $PGADMIN_DEFAULT_PASSWORD)
PGADMIN_DEFAULT_EMAIL=admin@local
PGADMIN_DEFAULT_PASSWORD=<PLACEHOLDER_PGADMIN_PASSWORD>
