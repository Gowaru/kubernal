# =============================================================================
# postgres Secret (TEMPLATE)
# =============================================================================
# ⚠️  NEVER COMMIT A REAL secret.yaml.
# Setup:
#   cp infra/k8s/postgres/secret.yaml.example infra/k8s/postgres/secret.yaml
#   # edit with your local/dev password (NEVER commit)
#
# Where to get values:
#   POSTGRES_PASSWORD — see docs/SECURITY.md § "Database credentials"
#                        Use `openssl rand -base64 24` to generate strong passwords.
#   POSTGRES_USER     — usually "kubernal" (matches DATABASE_URL in api/secret.yaml)
#   POSTGRES_DB       — usually "kubernal_idp"
# =============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  labels:
    app: postgres
    kubernal.io/managed-by: kubernal
type: Opaque
stringData:
  POSTGRES_USER: kubernal
  POSTGRES_PASSWORD: '<PLACEHOLDER_POSTGRES_PASSWORD>'
  POSTGRES_DB: kubernal_idp
