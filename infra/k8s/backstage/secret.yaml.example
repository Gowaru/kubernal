# =============================================================================
# backstage Secret (TEMPLATE)
# =============================================================================
# ⚠️  NEVER COMMIT A REAL secret.yaml.
# Setup:
#   cp infra/k8s/backstage/secret.yaml.example infra/k8s/backstage/secret.yaml
#   # edit with your local/dev values (NEVER commit)
#
# Where to get values:
#   GITHUB_CLIENT_SECRET — see docs/SECURITY.md § "GitHub OAuth App"
#                           Rotate at https://github.com/settings/developers
#                           (Settings → Developer settings → OAuth Apps → Kubernal)
#   POSTGRES_PASSWORD    — same as postgres/secret.yaml.example (shared cluster)
#   BACKEND_SECRET       — see docs/SECURITY.md § "Backstage backend"
#                           Use `openssl rand -base64 32`
# =============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: backstage-secret
  labels:
    app: backstage
    kubernal.io/managed-by: kubernal
type: Opaque
stringData:
  GITHUB_CLIENT_ID: '<PLACEHOLDER_GITHUB_CLIENT_ID>'
  GITHUB_CLIENT_SECRET: '<PLACEHOLDER_GITHUB_CLIENT_SECRET>'
  POSTGRES_PASSWORD: '<PLACEHOLDER_POSTGRES_PASSWORD>'
  BACKEND_SECRET: '<PLACEHOLDER_BACKEND_SECRET>'
