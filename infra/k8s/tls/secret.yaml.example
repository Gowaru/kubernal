# =============================================================================
# TLS Secret (TEMPLATE) — wildcard-kubernal-local-tls
# =============================================================================
# ⚠️  NEVER COMMIT A REAL secret.yaml (contains private key).
# Setup:
#   cp infra/k8s/tls/secret.yaml.example infra/k8s/tls/secret.yaml
#   # generate self-signed cert (or use mkcert) — see docs/SECURITY.md § "TLS"
#   openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
#     -keyout tls.key -out tls.crt \
#     -subj "/CN=*.kubernal.local" \
#     -addext "subjectAltName=DNS:*.kubernal.local,DNS:kubernal.local"
#   base64 -w0 tls.crt > tls.crt.b64
#   base64 -w0 tls.key > tls.key.b64
#   # paste into secret.yaml (NEVER commit)
#
# For production, use cert-manager + Let's Encrypt instead of committing a cert.
# =============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: wildcard-kubernal-local-tls
  namespace: ingress-nginx
  labels:
    kubernal.io/managed-by: kubernal
type: kubernetes.io/tls
stringData:
  # Replace with the output of `base64 -w0 tls.crt` (cert)
  tls.crt: '<BASE64_TLS_CRT_PLACEHOLDER>'
  # Replace with the output of `base64 -w0 tls.key` (private key)
  tls.key: '<BASE64_TLS_KEY_PLACEHOLDER>'
