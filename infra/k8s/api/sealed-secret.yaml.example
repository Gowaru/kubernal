# =============================================================================
# kubernal-api SealedSecret (TEMPLATE)
# =============================================================================
# ⚠️  This is a TEMPLATE — the encryptedData values are placeholders.
#
# SealedSecrets encrypts a regular Secret so it can be safely committed to git.
# The cluster's sealed-secrets controller decrypts it at apply time.
#
# Setup:
#   1. Create the plaintext secret first:
#      cp infra/k8s/api/secret.yaml.example infra/k8s/api/secret.yaml
#      # edit secret.yaml with your real values (NEVER commit)
#
#   2. Seal it with the cluster's public cert:
#      kubeseal --format yaml \
#        --secret-file infra/k8s/api/secret.yaml \
#        --cert scripts/sealed-secrets-cert.pem \
#        > infra/k8s/api/sealed-secret.yaml
#
#      Or use the helper script:
#      ./scripts/seal-secret.sh infra/k8s/api/secret.yaml
#
#   3. The resulting sealed-secret.yaml is safe to commit.
#      The original secret.yaml MUST stay in .gitignore.
#
# The controller decrypts this automatically when you `kubectl apply` it.
# =============================================================================

apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: kubernal-api-secret
  namespace: kubernal-dev
  labels:
    app: kubernal-api
    kubernal.io/managed-by: kubernal
spec:
  encryptedData:
    DATABASE_URL: AgBy3i4OJSWK+PiTySYZZA9rO43cGDEq...
    SESSION_SECRET: AgBy3i4OJSWK+PiTySYZZA9rO43cGDEq...
    INTERNAL_API_KEY: AgBy3i4OJSWK+PiTySYZZA9rO43cGDEq...
    GITHUB_CLIENT_ID: AgBy3i4OJSWK+PiTySYZZA9rO43cGDEq...
    GITHUB_CLIENT_SECRET: AgBy3i4OJSWK+PiTySYZZA9rO43cGDEq...
