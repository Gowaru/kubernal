# =============================================================================
# kubernal-api Secret (TEMPLATE)
# =============================================================================
# ⚠️  NEVER COMMIT A REAL secret.yaml — use placeholders or rotate + gitignore.
# This file IS committed (.example) as a template. The real secret.yaml is
# in .gitignore and stays local.
#
# Setup:
#   cp infra/k8s/api/secret.yaml.example infra/k8s/api/secret.yaml
#   # edit secret.yaml with your local/dev values (NEVER commit)
#
# Where to get values:
#   DATABASE_URL — see docs/SECURITY.md § "Database credentials"
#                  Format: postgresql://<user>:<password>@<host>:<port>/<db>?schema=public
#                  Dev: postgresql://kubernal:<PLACEHOLDER_DB_PASSWORD>@localhost:5432/kubernal_idp
#                  In-cluster: postgresql://kubernal:<PLACEHOLDER_DB_PASSWORD>@postgres-service:5432/kubernal_idp
# =============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: kubernal-api-secret
  labels:
    app: kubernal-api
    kubernal.io/managed-by: kubernal
type: Opaque
stringData:
  DATABASE_URL: 'postgresql://kubernal:<PLACEHOLDER_DB_PASSWORD>@postgres-service:5432/kubernal_idp?schema=public'
  SESSION_SECRET: '<PLACEHOLDER_SESSION_SECRET_32_CHARS>'
  INTERNAL_API_KEY: '<PLACEHOLDER_INTERNAL_API_KEY>'
  GITHUB_CLIENT_ID: '<PLACEHOLDER_GITHUB_CLIENT_ID>'
  GITHUB_CLIENT_SECRET: '<PLACEHOLDER_GITHUB_CLIENT_SECRET>'
