{
  "name": "kubernal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Internal Developer Platform (IDP) – Self-service application platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"**/*.{ts,tsx,json,yaml,yml}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,json,yaml,yml}\"",
    "typecheck": "tsc -b",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "eslint": "^10.3.0",
    "prettier": "^3.8.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
